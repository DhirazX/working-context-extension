{
  "name": "working-context",
  "displayName": "working context",
  "description": "An extension to preserve your working set ( files recently changed )",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workingContext",
          "title": "Working Context",
          "icon": "media/working-context.svg"
        }
      ]
    },
    "views": {
      "workingContext": [
        {
          "id": "workingContextView",
          "name": "Working Context"
        }
      ]
    },
    "commands": [
      {
        "command": "working-context.openFile",
        "title": "Open File"
      },
      {
        "command": "working-context.removeFile",
        "title": "Remove from Working Context",
        "icon": "$(close)"
      },
      {
        "command": "working-context.clearAll",
        "title": "Clear All",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "working-context.clearAll",
          "when": "view == workingContextView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "working-context.removeFile",
          "when": "view == workingContextView && viewItem == workingContextFile",
          "group": "inline"
        },
        {
          "command": "working-context.removeFile",
          "when": "view == workingContextView && viewItem == workingContextFile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
